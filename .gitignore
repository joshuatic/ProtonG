vkconfig_override.json

RenderDoc/
renderdoc/
*.rdc

Nsight/
nsight/
*.nsight-gfx

*.gfxreconstruct
*.vktrace



# =============================================================================
# Luau / Lua / Scripting Generated Files
# =============================================================================

*.luau.bytecode
*.lua.bytecode
*.luau.cache
*.lua.cache

.luau-cache/
luau-cache/
luau-analyze-cache/

*.luau.tmp
*.lua.tmp

# Keep Luau type definition files.
!*.d.luau



# =============================================================================
# Sandbox Runtime Files
# =============================================================================
#
# Keep sandbox scripts and small intentional assets.
# Ignore runtime output, generated files, captures, temp data, and caches.
#

sandbox/runtime/
sandbox/cache/
sandbox/temp/
sandbox/tmp/
sandbox/output/
sandbox/generated/
sandbox/recordings/
sandbox/captures/
sandbox/screenshots/

sandbox/**/*.tmp
sandbox/**/*.temp
sandbox/**/*.cache
sandbox/**/*.log



# =============================================================================
# Large / Generated Media Assets
# =============================================================================
#
# Engine repos can explode fast.
# Keep tiny intentional assets.
# Ignore large dumps, raw captures, generated frame folders, and source media.
#

sandbox/assets/**/frames/
sandbox/assets/**/video/
sandbox/assets/**/source/
sandbox/assets/**/generated/
sandbox/assets/**/cache/
sandbox/assets/**/temp/
sandbox/assets/**/tmp/
sandbox/assets/**/output/

assets/generated/
assets/cache/
assets/temp/
assets/tmp/
assets/output/

# Large raw video files.
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.wmv

# Audio files are ignored by default because licensing/size can get cursed.
# If you want to commit a tiny owned placeholder sound, force-add it or add
# a narrower exception below.
*.wav
*.mp3
*.ogg
*.flac

# Large audio project/session files.
*.flp
*.als
*.aup3

# Image project/source files.
*.psd
*.kra
*.xcf

# Keep docs/license notes inside asset folders.
!assets/**/*.md
!assets/**/README.md
!assets/**/LICENSE.md
!sandbox/assets/**/*.md
!sandbox/assets/**/README.md
!sandbox/assets/**/LICENSE.md

# Optional intentional sample media folder.
!sandbox/assets/**/samples/
!sandbox/assets/**/samples/**



# =============================================================================
# Screenshots / Captures
# =============================================================================

screenshots/
Screenshots/
captures/
Captures/
recordings/
Recordings/

*.bmp
*.tga

captures/**/*.png
captures/**/*.jpg
screenshots/**/*.png
screenshots/**/*.jpg

# Images/Assets
sandbox/assets/
!sandbox/assets/README.md


# =============================================================================
# Third Party Dependencies
# =============================================================================
#
# Keep vendored source dependencies:
# - Luau source
# - stb headers
# - miniaudio header
#
# Ignore build outputs inside third_party.
#

third_party/**/build/
third_party/**/out/
third_party/**/cmake-build-*/
third_party/**/CMakeFiles/
third_party/**/CMakeCache.txt

third_party/**/*.lib
third_party/**/*.dll
third_party/**/*.exe
third_party/**/*.pdb
third_party/**/*.obj
third_party/**/*.o
third_party/**/*.a
third_party/**/*.so
third_party/**/*.dylib

# Keep actual vendored source/docs/licenses.
!third_party/**/*.h
!third_party/**/*.hpp
!third_party/**/*.c
!third_party/**/*.cpp
!third_party/**/*.cc
!third_party/**/*.cxx
!third_party/**/*.cmake
!third_party/**/CMakeLists.txt
!third_party/**/*.md
!third_party/**/*.txt
!third_party/**/LICENSE*
!third_party/**/COPYING*



