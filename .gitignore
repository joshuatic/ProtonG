# =============================================================================
# Proton G .gitignore
# =============================================================================
#
# Stack:
# - C++20
# - CMake
# - Ninja / MSVC / Visual Studio toolchain
# - CLion / JetBrains IDEs
# - Vulkan SDK
# - GLFW
# - Luau
# - stb_image
# - miniaudio
# - sandbox runtime assets
#
# Goals:
# - Keep source code, scripts, shader source, docs, and vendored source.
# - Ignore build outputs, IDE state, logs, caches, binaries, generated media,
#   local machine config, and giant asset dumps.
#
# =============================================================================



# =============================================================================
# Build Directories
# =============================================================================

cmake-build-*/
build/
Build/
BUILD/
out/
Out/
OUT/
bin/
Bin/
BIN/
obj/
Obj/
OBJ/
lib/
Lib/
LIB/
target/

_generated/
generated/
Generated/

.cache/
.tmp/
temp/
Temp/
tmp/
Tmp/



