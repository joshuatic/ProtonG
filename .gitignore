# =============================================================================
# Keep Important Source Folders / Files
# =============================================================================
#
# Git does not track empty folders. Use .gitkeep files when needed.
#

!.gitkeep

!CMakeLists.txt
!README.md
!LICENSE
!LICENSE.md

!src/
!src/**/*.hpp
!src/**/*.h
!src/**/*.cpp
!src/**/*.c

!include/
!include/**/*.hpp
!include/**/*.h

!sandbox/
!sandbox/scripts/
!sandbox/scripts/**/*.luau
!sandbox/scripts/**/*.d.luau

!sandbox/shaders/
!sandbox/shaders/**/*.vert
!sandbox/shaders/**/*.frag
!sandbox/shaders/**/*.comp
!sandbox/shaders/**/*.geom
!sandbox/shaders/**/*.tesc
!sandbox/shaders/**/*.tese

!third_party/