# =============================================================================
# Vulkan Shader Build Outputs
# =============================================================================
#
# Keep shader source files.
# Ignore compiled SPIR-V by default because it can be rebuilt.
#

*.spv
*.spirv

!sandbox/shaders/*.spv

*.vert.spv
*.frag.spv
*.comp.spv
*.geom.spv
*.tesc.spv
*.tese.spv

sandbox/shaders/compiled/
sandbox/shaders/generated/
shaders/compiled/
shaders/generated/



